NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://snapkart:replace-this-with-a-unique-local-password@localhost:5432/snapkart?schema=public
POSTGRES_USER=snapkart
POSTGRES_PASSWORD=replace-this-with-a-unique-local-password
POSTGRES_DB=snapkart
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Use the frontend's exact origin(s), comma-separated. Production must use HTTPS.
CORS_ORIGIN=http://localhost:5173
# Set only behind a trusted Render/Cloudflare edge that overwrites CF-Connecting-IP.
TRUSTED_CLIENT_IP_HEADER=
PAYMENT_PROVIDER=mock
# Set true only in local development to test the staff gate with simulated payments.
ALLOW_SIMULATED_GATE_PAYMENTS=false
# Keep this secret on the server. /metrics returns 404 unless a matching bearer token is supplied.
METRICS_TOKEN=replace-with-a-long-random-secret
