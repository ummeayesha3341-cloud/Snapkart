NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://snapkart:replace-this-with-a-unique-local-password@localhost:5432/snapkart?schema=public
POSTGRES_USER=snapkart
POSTGRES_PASSWORD=replace-this-with-a-unique-local-password
POSTGRES_DB=snapkart
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
