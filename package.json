{
  "name": "snapkart-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config=playwright.live.config.js",
    "test:barcode": "node --test tests/barcode-formats.test.js",
    "test:api": "node --import tsx --test tests/api/*.test.js",
    "test:integration": "node --test tests/integration/catalog.test.js",
    "test:load": "node scripts/load-test.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^10.2.1",
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "@prisma/client": "^6.16.2",
    "@supabase/supabase-js": "^2.119.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.4.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.15.30",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
