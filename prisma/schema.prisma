generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum GateCheckOutcome {
  CLEARED
  FLAGGED
  DENIED
  DUPLICATE
}

enum InventoryMovementType {
  OPENING_BALANCE
  MANUAL_ADJUSTMENT
  SALE
  RETURN
  RECEIPT
}

enum StockReceiptStatus {
  DRAFT
  RECEIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PAYMENT_FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum DemandEventType {
  SCAN
  CART_ADD
  CART_REMOVE
  PURCHASE
  RETURN
  STOCKOUT_ATTEMPT
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

enum ReturnDisposition {
  RESTOCK
  QUARANTINE
  DISCARD
}

enum RefundStatus {
  NOT_STARTED
  SIMULATED
  CASH_PAID_OUT
}

enum ReturnAuditAction {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  supabaseUserId String?  @unique
  name         String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  cart         Cart?
  orders       Order[]
  returnRequests ReturnRequest[] @relation("ReturnCustomer")
  reviewedReturns ReturnRequest[] @relation("ReturnReviewer")
  returnAuditEvents ReturnAuditEvent[]
  gateChecks GateCheck[]
  inventoryAdjustments InventoryAdjustment[] @relation("InventoryAdjustmentAdmin")
  createdStockReceipts StockReceipt[] @relation("StockReceiptCreator")
  receivedStockReceipts StockReceipt[] @relation("StockReceiptReceiver")
}

model Product {
  id          String   @id @default(cuid())
  barcode     String   @unique
  name        String
  description String?
  category    String?
  brand       String?
  supplier    String?
  expiresAt   DateTime?
  priceMinor  Int
  currency    String   @default("INR")
  stock       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cartItems   CartItem[]
  orderItems  OrderItem[]
  demandEvents DemandEvent[]
  inventoryAdjustments InventoryAdjustment[]
  stockReceiptItems StockReceiptItem[]

  @@index([name])
  @@index([active, barcode])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

model Order {
  id             String      @id @default(cuid())
  receiptToken   String?     @unique
  userId         String
  status         OrderStatus @default(PENDING_PAYMENT)
  subtotalMinor  Int
  currency       String      @default("INR")
  idempotencyKey String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User        @relation(fields: [userId], references: [id])
  items          OrderItem[]
  payment        Payment?
  returnRequests ReturnRequest[]
  gateChecks GateCheck[]
  inventoryAdjustments InventoryAdjustment[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  barcode        String
  productName    String
  unitPriceMinor Int
  quantity       Int
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id])
  returnItems    ReturnItem[]

  @@index([orderId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  provider          String
  providerReference String?
  status            PaymentStatus @default(PENDING)
  amountMinor       Int
  currency          String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, provider])
}

model GateCheck {
  id          String           @id @default(cuid())
  orderId     String
  staffUserId String
  outcome     GateCheckOutcome
  note        String?
  createdAt   DateTime         @default(now())
  order       Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  staff       User             @relation(fields: [staffUserId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([staffUserId, createdAt])
}

model DemandEvent {
  id        String          @id @default(cuid())
  productId String
  type      DemandEventType
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, type, createdAt])
  @@index([createdAt])
}

model ReturnRequest {
  id                String            @id @default(cuid())
  orderId           String
  customerUserId    String
  reviewerAdminId   String?
  status            ReturnStatus      @default(REQUESTED)
  reason            String
  unusedAttested    Boolean           @default(false)
  adminNote         String?
  disposition       ReturnDisposition?
  refundStatus      RefundStatus      @default(NOT_STARTED)
  refundAmountMinor Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer          User              @relation("ReturnCustomer", fields: [customerUserId], references: [id])
  reviewer          User?             @relation("ReturnReviewer", fields: [reviewerAdminId], references: [id])
  items             ReturnItem[]
  auditEvents       ReturnAuditEvent[]

  @@index([customerUserId, createdAt])
  @@index([status, createdAt])
}

model ReturnItem {
  id              String        @id @default(cuid())
  returnRequestId String
  orderItemId     String
  quantity        Int
  unitPriceMinor  Int
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id])

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
}

model ReturnAuditEvent {
  id              String           @id @default(cuid())
  returnRequestId String
  actorUserId     String
  action          ReturnAuditAction
  note            String?
  createdAt       DateTime         @default(now())
  returnRequest   ReturnRequest    @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  actor           User             @relation(fields: [actorUserId], references: [id])

  @@index([returnRequestId, createdAt])
}

model InventoryAdjustment {
  id             String   @id @default(cuid())
  productId      String
  adminUserId    String?
  orderId        String?
  stockReceiptId String?
  movementType   InventoryMovementType @default(MANUAL_ADJUSTMENT)
  delta          Int
  resultingStock Int
  reason         String
  sourceSystem   String?
  externalReference String?
  createdAt      DateTime @default(now())
  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  adminUser      User? @relation("InventoryAdjustmentAdmin", fields: [adminUserId], references: [id], onDelete: SetNull)
  order          Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  stockReceipt   StockReceipt? @relation(fields: [stockReceiptId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([orderId])
  @@index([stockReceiptId])
  @@unique([sourceSystem, externalReference])
}

model StockReceipt {
  id                 String @id @default(cuid())
  supplier           String
  deliveryReference  String?
  notes              String?
  status             StockReceiptStatus @default(DRAFT)
  createdByAdminId   String
  receivedByAdminId  String?
  createdAt          DateTime @default(now())
  receivedAt         DateTime?
  createdBy          User @relation("StockReceiptCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  receivedBy         User? @relation("StockReceiptReceiver", fields: [receivedByAdminId], references: [id], onDelete: SetNull)
  items              StockReceiptItem[]
  movements          InventoryAdjustment[]

  @@index([status, createdAt])
  @@index([deliveryReference])
}

model StockReceiptItem {
  id              String @id @default(cuid())
  stockReceiptId  String
  productId       String
  quantity        Int
  unitCostMinor   Int?
  stockReceipt    StockReceipt @relation(fields: [stockReceiptId], references: [id], onDelete: Cascade)
  product         Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([stockReceiptId, productId])
  @@index([productId])
}
